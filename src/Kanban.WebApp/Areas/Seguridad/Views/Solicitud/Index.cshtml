@{
    ViewBag.Title = "Seguridad - Lista de Solicitudes";
}
<style>
    table {
        white-space: nowrap;
    }
</style>
<div class="row">
    <div class="col-md-12">
        <div class="card card-danger-border">
            <div class="card-header">
                <h6 class="card-title"><i class="fa fa-bookmark"></i>&nbsp; SOLICITUDES DE REGISTRO</h6>
                <img src="/images/logo-ola-sm.png" class="float-right" style="height: 25px;">
                <img src="/images/logo-suma-sm.png" class="float-right" style="height: 25px; width: 90px;">
            </div>
            <div class="card-body">
                <div class="form-row" id="Filtros">
                    <div class="col-md-3 col-sm-6">
                        <label>Nombre:</label>
                        <input class="form-control form-control-sm" id="FNombre" placeholder="Ingrese el nombre">
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label>Apellido:</label>
                        <input class="form-control form-control-sm" id="FApellido" placeholder="Ingrese el apellido">
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label>Nro. Documento:</label>
                        <input class="form-control form-control-sm" id="FNroDocumento" placeholder="Ingrese el nro. de documento">
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <label>Correo:</label>
                        <input class="form-control form-control-sm" id="FCorreo" placeholder="Ingrese el correo">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card card-info">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblIndex" 
                           class="table table-nowrap table-sm table-bordered table-hover" 
                           data-function="index.Listar"
                           data-pageindex="1"
                           data-totalrows="0" 
                           data-pagesize="20"
                           data-paginator="#paginator">
                        <thead>
                            <tr class="bg-success text-center">
                                <th width="40">#</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Nro. Documento</th>
                                <th>Correo</th>
                                <th>Telefono</th>
                                <th width="100">Fecha Registro</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end" id="paginator"></div>
            </div>
        </div>
    </div>
</div>

<script>
    var index = {
        Listar: function (page) {
            var table = $("#tblIndex");
            var model = {
                'pageIndex': page,
                'pageSize': table.data('pagesize'),
                'filter.Nombre': $("#FNombre").val(),
                'filter.Apellido': $("#FApellido").val(),
                'filter.NroDocumento': $("#FNroDocumento").val(),
                'filter.Correo': $("#FCorreo").val(),
            };
            $.ajax({
                url: "/Seguridad/Solicitud/ListarPorPagina",
                type: "GET",
                data: model,
                dataType: "json",
                beforeSend: function (xhr) {
                    $('.refresh-container').attr('style', 'display: block');
                },
                complete: function () {
                    $('.refresh-container').removeAttr('style');
                },
                success: function (data) {
                    table.data('pageindex', page);
                    table.data('totalrows', data.totalRows);
                    index.GenerarTabla(table, data.lista);
                    if (data.totalRows == 0) table.children('tbody').append("<tr><td colspan='7' class='text-center'>No existen registros</td></td>");
                },
                error: function (data) {
                    helper.errorShow('#Error', data.responseText)
                }
            });
        },
        GenerarTabla: function (table, lista) {
            var tbody = table.children('tbody');
            tbody.children('tr').remove();
            var rows = '';
            var numero = (table.data('pagesize') * table.data('pageindex')) - table.data('pagesize');
            $.each(lista, function (i, r) {
                rows += `<tr>
                            <td class="text-right">${++numero}</td>
                            <td>${r.Nombre}</td>
                            <td>${r.Apellido}</td>
                            <td>${r.NroDocumento}</td>
                            <td>${r.Correo}</td>
                            <td>${r.Telefono || ''}</td>
                            <td class="text-center">${r.FechaRegistro}</td>
                        </tr>`;
            });
            helper.pagination.update(table);
            tbody.append(rows);
        }
    };
    $(function () {
        $("#Filtros input").keypress(function (e) {
            var keyCode = e.keyCode
            if (keyCode == 13) index.Listar(1);
        });

        $('#btnNuevo').click(function () {
            location.href = '/Seguridad/Rol/Nuevo';
        });
        $("#tblIndex tbody").delegate('span.editar', 'click', function () {
            var id = $(this).data('id');
            location.href = '/Seguridad/Rol/Editar/' + id;

        });
        index.Listar(1);
    });

</script>