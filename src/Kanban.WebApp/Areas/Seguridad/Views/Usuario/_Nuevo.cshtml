@model Usuario
<link href="~/plugins/jstree/css/style.min.css" rel="stylesheet" />
<div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
        @using (Html.BeginForm("Nuevo", "Pagina", null, FormMethod.Post, null, new { @id = "form-modal-editar" }))
        {
            <div class="modal-header">
                <h5 class="modal-title">Nuevo Usuario</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <div class="card card-primary card-outline card-outline-tabs mb-0  shadow-none">
                    <div class="card-header p-0 border-bottom-0">
                        <ul class="nav nav-tabs" id="custom-tabs-four-tab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" data-toggle="pill" href="#tab1" role="tab">General</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-toggle="pill" href="#tab2" role="tab">Nivel</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-toggle="pill" href="#tab3" role="tab">Permiso</a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content">
                            <div class="tab-pane fade active show" id="tab1" role="tabpanel">
                                <div class="form-row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label>Nombre: <span class="text-danger">(*)</span></label>
                                            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control form-control-sm", @maxLength = "100" })
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label>Clave: <span class="text-danger">(*)</span></label>
                                            @Html.PasswordFor(m => m.Clave, new { @class = "form-control form-control-sm", @maxLength = "50" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label>Empleado: <span class="text-danger">(*)</span></label>
                                            @Html.DropDownListFor(m => m.EmpleadoId, new SelectList(ViewBag.Empleados, "Id", "Nombre", "SELECCIONE"), new { @class = "form-control form-control-sm" })
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-group">
                                            <label>Rol: <span class="text-danger">(*)</span></label>
                                            @Html.DropDownListFor(m => m.RolId, new SelectList(ViewBag.Roles, "Id", "Nombre", "SELECCIONE"), new { @class = "form-control form-control-sm" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="col">
                                        <div class="form-group">
                                            <label>Activar caducidad de contraseña: </label>
                                            <select class="form-control form-control-sm" id="ActivarCaducidad">
                                                <option value="true">SI</option>
                                                <option value="false">NO</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="form-group">
                                            <label>Renovación de clave cada: </label>
                                            <div class="input-group input-group-sm">
                                                <input class="form-control form-control-sm text-right" value="@Model.DiasVencimiento" disabled="disabled" />
                                                <div class="input-group-append">
                                                    <span class="input-group-text">
                                                        Dias
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>Activo:</label>
                                            @Html.CheckBoxFor(m => m.Activo)
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="tab2" role="tabpanel">
                                <div class="form-row">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>Estructura:</label>
                                            <input class="form-control form-control-sm" disabled="disabled" id="Estructura" />
                                            @Html.HiddenFor(m => m.EstructuraId)
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div id="NivelEstructura"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="tab3" role="tabpanel">
                                <div class="form-row">
                                    <div class="col-12">
                                        <div id="TreeEstructura"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="msgEditar"></div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-save"></i>&nbsp; Guardar</button>
                <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal"><i class="fa fa-times"></i>&nbsp;Cancelar</button>
            </div>
        }
    </div>
</div>
<script src="~/plugins/jstree/js/jstree.min.js"></script>
<script>
    var treeEstructura = @(Html.Raw(ViewBag.EstructuraJson ?? "[]"));

    var nuevo = {
        ObtenerModelo: function () {
            var model = {
                'nombre': $('#Nombre').val(),
                'clave': $('#Clave').val(),
                'empleadoId': $('#EmpleadoId').val(),
                'rolId': $('#RolId').val(),
                'activo': $('#Activo').prop('checked'),
                'estructuraId': $('#EstructuraId').val(),
                'activarCaducidad': $('#ActivarCaducidad').val(),
                'estructuras': []
            };

            $.each($("#TreeEstructura").jstree("get_checked", null, true), function (i, r) {
                var node = $("#TreeEstructura").jstree().get_node(r);
                if (node.id != "0") model.estructuras.push({ estructuraId: node.id, acceso: true });
            });

            $("#TreeEstructura").find(".jstree-undetermined").each(function (i, r) {
                var node = $("#TreeEstructura").jstree().get_node(r);
                if (node.id != "0") model.estructuras.push({ estructuraId: node.id, acceso: false });
            });

            return model;
        }
    };

    $(function () {
        $('#NivelEstructura').jstree({
            plugins: ["wholerow"],
            search: { show_only_matches: true },
            core: {
                check_callback: true,
                data: treeEstructura,
                animation: '1',
                themes: {
                    name: 'proton',
                    responsive: true
                }
            }
        }).on("select_node.jstree", function (evt, { node }) {
            $('#Estructura').val(node.text);
            $('#EstructuraId').val(node.id);
        });

        $('#TreeEstructura').jstree({
            plugins: ["wholerow", "checkbox"],
            checkbox: { "keep_selected_style": false },
            search: { show_only_matches: true },
            core: {
                check_callback: true,
                data: treeEstructura,
                animation: '1',
                themes: {
                    name: 'proton',
                    responsive: true
                }
            }
        });

        $('#RolId').change(function () {
            var valor = $(this).val()

            if (valor == @RolMaestro.ADMINISTRADOR) {
                $('#ActivarCaducidad').removeAttr('disabled');
            } else {
                $('#ActivarCaducidad').val('true')
                    .attr('disabled', 'disabled');
            }
        })

        $('#form-modal-editar').submit(function (e) {
            var model = nuevo.ObtenerModelo();
            $.ajax({
                type: "POST",
                url: "/Seguridad/Usuario/Nuevo",
                data: model,
                beforeSend: function () {
                    $("#msgEditar").hide();
                    $('#form-modal-editar button').attr("disabled", "disabled");
                    helper.wait.append('.modal-footer');
                },
                complete: function () {
                    helper.wait.remove('.modal-footer');
                },
                success: function (result) {
                    SetNuevoUsuario();
                },
                error: function (result) {
                    helper.wait.remove('.modal-footer');
                    helper.errorShow('#msgEditar', result.responseText);
                    $("#msgEditar").slideDown();
                    $('#form-modal-editar button').removeAttr("disabled");
                }
            });

            e.preventDefault();
        });
    });
</script>
