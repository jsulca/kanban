    dropzones.forEach(zona => {
        zona.addEventListener("dragover", (event) => {
            event.preventDefault();
        });
        zona.addEventListener('dragenter', (event) => {
            //event.target.style.opacity = .5;
            //$(event.target).closest('div.card').css('animation', 'pulse 1s infinite');
            event.target.style.animation = "pulse 1s infinite";
        });
        zona.addEventListener('dragleave', (event) => {
            //event.target.style.opacity = 1;
            //$(event.target).closest('div.card').css('animation', '');
            //var card = $(event.target).closest('div.card').get(0);
            //card.style.animation = "";
            event.target.style.animation = "";
        });
        zona.addEventListener('drop', (event) => {
            //event.target.style.opacity = 1;
            event.target.style.animation = "";

            var cardCompromiso = $(compromiso).closest('div.card');
            var estadoCompromiso = compromiso.dataset.estado;
            var instanciaCompromiso = compromiso.dataset.instanciaid;

            var card = $(event.target).closest('div.card').get(0);
            switch (card.dataset.tipo) {
                case "ESTADO":
                    var ok = gestion.ValidarEstado(estadoCompromiso, card.dataset.estado);
                    if (ok) gestion.ActualizarEstado(compromiso.dataset.id, card.dataset.estado, cardCompromiso, $(card));
                    break;
                case "INSTANCIA":
                    var ok = gestion.ValidarInstancia(estadoCompromiso, instanciaCompromiso, card.dataset.instanciaid * 1, cardCompromiso, $(card));
                    if (ok) {
                        Swal.fire({
                            input: 'textarea',
                            inputPlaceholder: 'Ingrese el motivo',
                            showCancelButton: true,
                            confirmButtonText: 'Aceptar',
                            cancelButtonText: 'Cancelar',
                        }).then(x => {
                            if (x.value) {
                                gestion.ActualizarInstancia(compromiso.dataset.id, card.dataset.instanciaid * 1, x.value, cardCompromiso, $(card));
                            } else Toast.fire({ type: 'error', title: 'Es necesario ingresar un motivo.' });
                        });
                    }
                    break;
            }
        });
    });

        var Calendar = FullCalendar.Calendar;
        //var Draggable = FullCalendarInteraction.Draggable;
        var calendarEl = document.getElementById('calendar');

        var calendar = new Calendar(calendarEl, {
            locale: 'es',
            plugins: ['bootstrap', 'interaction', 'dayGrid', 'timeGrid'],
            header: { left: 'prev,next today', center: 'title', right: '' },
            themeSystem: 'bootstrap',
            eventSources: [gestion.ActualizarCalendario],
            editable: true,
            eventLimit: true,
            eventResize: function ({ revert }) { revert(); },
            eventRender: function ({ event, el }) {
                var { icon } = event._def.extendedProps;
                if (icon) $(el).find(".fc-title").prepend("<i class='" + icon + "'></i>&nbsp;");
                $(el).bind('dblclick', function () {
                    gestion.AbrirModal('/Compromiso/Asignar', { id: event.id, callBack: 'SetAsignar' });
                });
            },
            eventDrop: function ({ event, revert }) {
                var fechaReprogramar = moment(event.start.getTime());
                var { estado } = event.extendedProps;
                if (estado != '@EstadoCompromiso.REPROGRAMADO') {
                    if (fechaReprogramar.diff(hoy, 'days') >= 0) {
                        gestion.ActualizarEstado(event.id, '@EstadoCompromiso.REPROGRAMADO', null, null, true, fechaReprogramar.format('DD/MM/YYYY'), revert);
                    } else {
                        Swal.fire({ title: 'Ocurrió un problema!', text: 'No puede reprogramar una fecha anterior a hoy.' });
                        revert();
                    }
                } else {
                    Swal.fire({ title: 'Ocurrió un problema!', text: 'No puede reprogramar un compromiso que se encuentra REPROGRAMADO.' });
                    revert();
                }
            }
        });

        calendar.render();


    $(function () {

        @if(cantidadFueraFecha > 0)
        {
            <text>
            Swal.fire({ title: 'Alerta!', text: 'Tiene @cantidadFueraFecha compromiso(s) en FUERA DE FECHA.' });
            </text>
        }

        $('#calendar').delegate('td[data-date]', 'dragover', function (event) {
            event.preventDefault();
        });

        $('#calendar').delegate('td[data-date]', 'dragenter', function (event) {
            var dataDate = this.dataset.date;
            $(`td.fc-day[data-date="${dataDate}"]`).css({ 'background': 'rgb(188,232,241)', 'opacity': '.2' });
        });

        $('#calendar').delegate('td[data-date]', 'dragleave', function () {
            var dataDate = this.dataset.date;
            $(`td.fc-day[data-date="${dataDate}"]`).css({ 'background': '', 'opacity': '' });
        });

        $('#calendar').delegate('td[data-date]', 'drop', function () {
            var dataDate = this.dataset.date;
            $(`td.fc-day[data-date="${dataDate}"]`).css({ 'background': '', 'opacity': '' });
            var fechaCalendario = moment(dataDate, 'YYYY-MM-DD');
            var cardCompromiso = $(compromiso).closest('div.card');

            if (fechaCalendario.diff(hoy, 'days') >= 0) {
                if (cardCompromiso[0].dataset.tipo == 'INSTANCIA') {
                    gestion.ActualizarEstado(compromiso.dataset.id, '@EstadoCompromiso.PROGRAMADO', cardCompromiso, null, true, fechaCalendario.format('DD/MM/YYYY'));
                    calendar.refetchEvents();
                } else {
                    if (compromiso.dataset.estado == '@EstadoCompromiso.FUERA_DE_FECHA') {
                        var ok = gestion.ValidarEstado(compromiso.dataset.estado, '@EstadoCompromiso.REPROGRAMADO', cardCompromiso.data("instanciaid"));
                        if (ok) {
                            gestion.ActualizarEstado(compromiso.dataset.id, '@EstadoCompromiso.REPROGRAMADO', cardCompromiso, null, true, fechaCalendario.format('DD/MM/YYYY'));
                            calendar.refetchEvents();
                        }
                    } else {
                        var ok = gestion.ValidarEstado(compromiso.dataset.estado, '@EstadoCompromiso.PROGRAMADO', cardCompromiso.data("instanciaid"));
                        if (ok) {
                            gestion.ActualizarEstado(compromiso.dataset.id, '@EstadoCompromiso.PROGRAMADO', cardCompromiso, null, true, fechaCalendario.format('DD/MM/YYYY'));
                            calendar.refetchEvents();
                        }
                    }
                }
            } else  Swal.fire({ title: 'Ocurrió un problema!', text: 'No puede programar o reprogramar una fecha anterior a hoy.' });
        });

        $('.nuevo').dblclick(function () {
            gestion.AbrirModal('/Compromiso/Nuevo', { 'tableroId': @Model.Id });
        });

        gestion.EventoDrag();
    });

    var SetAsignar = (model) => {
        $('#modal-ventana').modal('hide');
        var comp = $(`.compromiso[data-id="${model.id}"]`).get(0);
        if (comp) {
            var cardCompromiso = $(comp).closest('div.card');
            var model;
            //actualizar tablero
            if (comp.dataset.instanciaid) model = { tableroId: @Model.Id, instanciaid: comp.dataset.instanciaid };
            else model = { tableroId: @Model.Id, estado: comp.dataset.estado, instanciaid: 0 };
            $.ajax({
                    type: "POST",
                    url: "/Compromiso/Listar",
                    data: model,
                    beforeSend: function () {
                        cardCompromiso.append(`<div class="card-img-overlay card-wait text-center"><div class="spinner-grow text-warning" role="status"><span class="sr-only">Cargando...</span></div></div>`);
                    },
                    complete: function () {
                        cardCompromiso.find('div.card-wait').remove();
                    },
                    success: function (data) {
                        //Listar compromisos
                        cardCompromiso.find('div.card-body').children('div.compromiso').remove();
                        cardCompromiso.find('div.card-body').append(gestion.ObtenerCompromisos(data));
                        gestion.EventoDrag();
                    },
                    error: function () {
                        $.get('/ErrorHandler/GetError', {}, (data) => {
                            var err = data;
                            Swal.fire({
                                icon: 'error',
                                title: 'Ocurrió un problema!',
                                html: err
                            })
                        })
                    }
                });
        } else {
            if (model['model.PorVerificar']) {
                cardCompromiso = $('div.card[data-tipo="ESTADO"][data-estado="@EstadoCompromiso.POR_VERIFICAR"]');
                $.ajax({
                    type: "POST",
                    url: "/Compromiso/Listar",
                    data: {
                        tableroId: @Model.Id,
                        estado: '@EstadoCompromiso.POR_VERIFICAR',
                        instanciaid: 0
                    },
                    beforeSend: function () {
                        cardCompromiso.append(`<div class="card-img-overlay card-wait text-center"><div class="spinner-grow text-warning" role="status"><span class="sr-only">Cargando...</span></div></div>`);
                    },
                    complete: function () {
                        cardCompromiso.find('div.card-wait').remove();
                    },
                    success: function (data) {
                        //Listar compromisos
                        cardCompromiso.find('div.card-body').children('div.compromiso').remove();
                        cardCompromiso.find('div.card-body').append(gestion.ObtenerCompromisos(data));

                        gestion.EventoDrag();
                    },
                    error: function () {
                        $.get('/ErrorHandler/GetError', {}, (data) => {
                            var err = data;
                            Swal.fire({
                                icon: 'error',
                                title: 'Ocurrió un problema!',
                                html: err
                            })
                        })
                    }
                });
            }
            calendar.refetchEvents();
        }
    }

    var SetRechazar = (item) => {
