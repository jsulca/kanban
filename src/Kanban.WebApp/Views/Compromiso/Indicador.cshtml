    $(function () {
        $('#btnBuscar').click(function () {
            var model = indicador.ObtenerModelo();
            $.ajax({
                url: "/Compromiso/Indicador",
                type: "POST",
                data: model,
                dataType: "json",
                beforeSend: function (xhr) {
                    $('.indicador').attr('hidden', 'hidden');
                    $('#FTableroId, #FAnio, #FMes').attr('disabled', 'disabled');
                },
                complete: function () {
                    $('.indicador').removeAttr('hidden');
                    $('#FTableroId, #FAnio, #FMes').removeAttr('disabled');
                },
                success: function (data) {
                    //Indicador por estado
                    indicador.IndicadorPorEstado_1(data.Indicadores, data.IndicadorPorEstado_1_1, data.IndicadorPorEstado_1_2);
                    indicador.IndicadorPorEstado_2(data.Indicadores, data.Areas, data.IndicadorPorEstado_1_1);
                    indicador.IndicadorPorEstado_3(data.Indicadores, data.Areas, data.IndicadorPorEstado_1_1);
                    indicador.IndicadorPorResponsable(data.Empleados, data.IndicadorPorEstado_1_1, data.IndicadorPorEstado_1_2);
                    indicador.IndicadorPorArea_1(data.Areas, data.Indicadores, data.IndicadorPorEstado_1_1, data.IndicadorPorEstado_1_2);
                    indicador.IndicadorPorArea_2(data.Areas, data.IndicadorPorEstado_1_1, data.IndicadorPorEstado_1_2);
                },
                error: function (data) {
                    $('.indicador').attr('hidden', 'hidden');
                    $.get('/ErrorHandler/GetError', {}, (data) => {
                        helper.errorShow('#mensajes', data);
                    })
                }
            });
        });

        window.chartIndicadorPorEstado_1 = new Chart(document.getElementById('chartIndicadorPorEstado_1').getContext('2d'), {
            type: 'bar',
            data: {},
            options: {
                title: { display: false },
