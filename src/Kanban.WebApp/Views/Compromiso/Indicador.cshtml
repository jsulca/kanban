    var tooltipPercent = (tooltipItem, data) => {
        var index = tooltipItem.index;
        var total = 0;
        $.each(data.datasets, function (x, r) {
            if (r._meta[Object.keys(data.datasets[x]._meta)[0]].hidden == null) total += r.data[index];
        })
        var label = data.datasets[tooltipItem.datasetIndex].label || '';
        if (label) label += ': ';
        var porcentaje = (tooltipItem.yLabel / total) * 100;
        if (!isNaN(porcentaje)) label += helper.format.decimal((tooltipItem.yLabel / total) * 100);
        else label += 0;
        return label + ' %';
    }

