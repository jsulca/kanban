@{
    Layout = "~/Views/Shared/_LayoutAccount.cshtml";
}
@model AccountModel.ChangePassword

@using (Html.BeginForm("ChangePassword", "Account", new { }, FormMethod.Post, null, new { @id = "form-login" }))
{
    @Html.HiddenFor(m => m.Id)
    <div class="mb-3 text-center">
        <h4 class="text-info">@ViewBag.Motivo</h4>
    </div>
    <div class="input-group mb-3">
        @Html.PasswordFor(m => m.NuevaClave, new { @class = "form-control", placeholder = "Nueva clave", autocomplete = "off" })
        <div class="input-group-append">
            <div class="input-group-text">
                <span class="fas fa-lock"></span>
            </div>
        </div>
    </div>
    <div class="input-group mb-3">
        @Html.PasswordFor(m => m.ConfirmacionClave, new { @class = "form-control", placeholder = "Confirmar clave", autocomplete = "off" })
        <div class="input-group-append">
            <div class="input-group-text">
                <span class="fas fa-lock"></span>
            </div>
        </div>
    </div>
    <div class="mb-3 text-right">
        <label>
            Mostrar clave
            <input type="checkbox" id="checkMostrarClave" />
        </label>
    </div>
    if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Error!</strong>
            @{
                Html.RenderPartial("_Error");
            }
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    <div class="row">
        <div class="col-12 text-right mb-2">
            <button type="submit" class="btn btn-danger btn-block">Cambiar clave</button>
        </div>
        <div class="col-12 text-right">
            <a href="/Account/Login" class="btn btn-warning btn-block">Regresar</a>
        </div>
    </div>
}

<script>
    $(function () {
        $('#checkMostrarClave').change(function () {
            var isChecked = $(this).prop('checked');
            if (isChecked) $('#NuevaClave, #ConfirmacionClave').prop('type', 'text');
            else $('#NuevaClave, #ConfirmacionClave').prop('type', 'password');
        });
    });
</script>