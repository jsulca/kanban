@{
    ViewBag.Title = "Manual - Seguridad";
    ViewBag.Seccion = "Seguridad";

    var temas = new List<DocumentacionModel.Tema>
    {
        new()
        {
            Id = "como-funciona",
            Titulo = "Cómo funcionan los permisos",
            Icono = "fa fa-circle-info",
            ParaQue = "Antes de tocar nada conviene entender el encadenado, porque los cuatro maestros "
