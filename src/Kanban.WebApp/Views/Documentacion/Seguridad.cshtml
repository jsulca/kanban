                new("La clave debe contener un carácter en mayuscula", "Falta una mayúscula."),
                new("La clave debe contener un número", "Falta un número."),
                new("La clave debe contener al menos una carácter especial.", "Falta un símbolo como ! @@ # $ % ^ &amp; *."),
                new("Seleccione un empleado.", "No se enlazó el usuario a ningún empleado."),
                new("Seleccione un rol.", "No se eligió rol."),
