<link href="~/css/documentacion.css" rel="stylesheet" />

<div class="row">
    <div class="col-lg-3 d-print-none">
        @await Html.PartialAsync("_Nav", temas)
    </div>
    <div class="col-lg-9">
        <div class="card card-default">
            <div class="card-header bg-danger">
                <h3 class="card-title font-weight-bold">
                    <i class="fa fa-database"></i>&nbsp; Maestros
                </h3>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    Los maestros son las listas de las que se alimenta el resto del sistema. Conviene
                    darlos de alta en este orden, porque cada uno depende del anterior:
                    <b>Colores → Áreas → Cargos → Empleados → Estructuras</b>. Los demás
                    (orígenes, indicadores, instancias y tipos de verificación) pueden crearse en
                    cualquier momento.
                </p>
            </div>
        </div>

        @foreach (var tema in temas)
        {
            @await Html.PartialAsync("_Tema", tema)
        }
    </div>
</div>
