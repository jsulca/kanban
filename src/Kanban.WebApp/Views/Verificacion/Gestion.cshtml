        ObtenerModelo: function () {
            var model = {};

            var anio = $('#Anio').val(),
                mes = $('#Mes').val(),
                estructuraId = @Model.Id;

            var contador = 0;
            $.each($('#tblVerificaciones tbody tr'), function (i, tr) {
                $.each($(tr).find('input.nro-semana'), function (y, input) {
                    model['semanas[' + contador + '].EstructuraId'] = estructuraId;
                    model['semanas[' + contador + '].EmpleadoId'] = input.dataset.empleadoid;
                    model['semanas[' + contador + '].TipoVerificacionId'] = input.dataset.tipoverificacionid;
                    model['semanas[' + contador + '].Anio'] = anio;
                    model['semanas[' + contador + '].Mes'] = mes;
                    model['semanas[' + contador + '].NroSemana'] = input.value;
                    contador++;
                });

                var comentario = $(tr).find('input.comentario');

                model['comentarios[' + i + '].EstructuraId'] = estructuraId;
                model['comentarios[' + i + '].EmpleadoId'] = comentario[0].dataset.empleadoid;
                model['comentarios[' + i + '].Anio'] = anio;
                model['comentarios[' + i + '].Mes'] = mes;
                model['comentarios[' + i + '].Comentario'] = comentario[0].value;

            });

            contador = 0;
            $.each($(`#tblVerificacionesSostenibilidad tbody tr`), function (i, tr) {

                $.each($(tr).find('input.nro-mes'), function (y, input) {
                    model['meses[' + contador + '].EstructuraId'] = estructuraId;
                    model['meses[' + contador + '].EmpleadoId'] = input.dataset.empleadoid;
                    model['meses[' + contador + '].TipoVerificacionId'] = input.dataset.tipoverificacionid;
                    model['meses[' + contador + '].Anio'] = anio;
                    model['meses[' + contador + '].NroAnio'] = input.value;
                    contador++;
                });
            });

            return model;
        },
        ValidarColores: function () {
            $.each($('#tblVerificaciones tbody tr'), function (i, tr) {
                var nro_semanas = $(tr).find(`input.nro-semana[data-tipoverificacionid]`);
                $.each(nro_semanas, function (x, input) {
                    var semanas = $(`#tblVerificaciones td[data-empleadoid='${input.dataset.empleadoid}'][data-tipoverificacionid='${input.dataset.tipoverificacionid}']`);
                    var totalSemana = 0;
                    $.each(semanas, function (z, sem) {
                        totalSemana += (input.value * 1) > (sem.innerText * 1) ? (sem.innerText * 1) : (input.value * 1);
                        if ((sem.innerText * 1) >= (input.value * 1)) {
                            sem.classList.remove('text-danger')
                            sem.classList.add('text-success')
                        }
                        else {
                            sem.classList.remove('text-success')
                            sem.classList.add('text-danger')
                        }
                    });

                    var cantidadPorSemana = (input.value * 5) == 0 ? 1 : (input.value * 5);
                    $(`#tblVerificaciones span.total[data-empleadoid='${input.dataset.empleadoid}'][data-tipoverificacionid='${input.dataset.tipoverificacionid}']`).text(totalSemana);
                    $(`#tblVerificaciones span.total_[data-empleadoid='${input.dataset.empleadoid}'][data-tipoverificacionid='${input.dataset.tipoverificacionid}']`).text(cantidadPorSemana);
                    $(`#tblVerificaciones span.porcentaje[data-empleadoid='${input.dataset.empleadoid}'][data-tipoverificacionid='${input.dataset.tipoverificacionid}']`).text(helper.format.decimal((totalSemana / cantidadPorSemana) * 100));
                });
            });

            $.each($('#tblVerificacionesSostenibilidad tbody tr'), function (i, tr) {
                var nro_semanas = $(tr).find(`input.nro-mes[data-tipoverificacionid]`);
                $.each(nro_semanas, function (x, input) {
                    var semanas = $(`#tblVerificacionesSostenibilidad th[data-empleadoid='${input.dataset.empleadoid}'][data-tipoverificacionid='${input.dataset.tipoverificacionid}']`);
                    var totalSemana = 0;

                    $.each(semanas, function (z, sem) {
                        totalSemana += (input.value * 1) > (sem.innerText * 1) ? (sem.innerText * 1) : (input.value * 1);
                        if ((sem.innerText * 1) >= (input.value * 1)) {
                            sem.classList.remove('text-danger')
                            sem.classList.add('text-success')
                        }
                        else {
                            sem.classList.remove('text-success')
                            sem.classList.add('text-danger')
                        }
                    });

                    var cantidadPorSemana = (input.value * 12) == 0 ? 1 : (input.value * 12);
                    $(`#tblVerificacionesSostenibilidad span.total[data-empleadoid='${input.dataset.empleadoid}'][data-tipoverificacionid='${input.dataset.tipoverificacionid}']`).text(totalSemana);
                    $(`#tblVerificacionesSostenibilidad span.total_[data-empleadoid='${input.dataset.empleadoid}'][data-tipoverificacionid='${input.dataset.tipoverificacionid}']`).text(cantidadPorSemana);
                    $(`#tblVerificacionesSostenibilidad span.porcentaje[data-empleadoid='${input.dataset.empleadoid}'][data-tipoverificacionid='${input.dataset.tipoverificacionid}']`).text(helper.format.decimal((totalSemana / cantidadPorSemana) * 100));
                });
            });
        }
    };

    $(function () {

        gestion.ValidarColores();

        $('#btnEditar').click(function () {
            $('#tblVerificacionesSostenibilidad input, #tblVerificaciones input').removeAttr('disabled');
            $('#btnEditar').attr('hidden', 'hidden');
            $('#btnGuardar').removeAttr('hidden');
        });
        $('#btnGuardar').click(function () {
            $('#btnEditar').removeAttr('hidden');
            $('#btnGuardar').attr('hidden', 'hidden');
        });
        $('#Anio, #Mes').change(function () {
            $('#btnEditar').removeAttr('hidden');
            $('#btnGuardar').attr('hidden', 'hidden');
            $('#tblVerificacionesSostenibilidad input, #tblVerificaciones input').attr('disabled', 'disabled');

            gestion.Listar();
        });

        $('#btnGuardar').click(function () {
            var model = gestion.ObtenerModelo();
            $.ajax({
                type: "POST",
                url: "/Verificacion/GuardarTablero",
                data: model,
                beforeSend: function () {
                    $("#Error").hide();
                    $('#btnGuardar').attr("disabled", "disabled");
                    helper.wait.append('#Error');
                },
                complete: function () {
                    $('#btnGuardar').removeAttr("disabled");
                    helper.wait.remove('#Error');
                },
                success: function (result) {
                    $('input').attr('disabled', 'disabled');
                    Swal.fire({
                        title: 'Se actualizo la información',
                    }).then(() => {
                        gestion.Listar();
                    });
                },
                error: function () {
                    helper.wait.remove('#Error');
                    $.get('/ErrorHandler/GetError', {}, (data) => {
                        helper.errorShow('#Error', data);
                        $("#Error").slideDown();
                        $('#btnGuardar').removeAttr("disabled");
                    })
                }
            });
        });
    });
